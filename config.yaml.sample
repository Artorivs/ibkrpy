# config.yaml
# Trading system configuration

# ============================================================
# 1. General settings
general_settings:
  benchmark_symbol: "QQQ"

  # --- Term floor ---
  # short_term | mid_term | long_term
  min_term: "long_term"
  analyzer_lookback: 60
  short_term_bar_size: "5 mins"
  mid_term_bar_size: "1 hour"
  long_term_bar_size: "1 day"

# ============================================================
# 2. Logging
log_settings:
  level: "INFO"              # Console level (the log file is always DEBUG)
  enable_email_alerts: false
  alert_throttle_minutes: 30   # One email per call site per window (console and file still log everything)
  # Required when email alerts are on; alerts stay off if any is missing (reported at startup)
  # smtp_server: "smtp.gmail.com"
  # smtp_port: 587
  # sender_email: ""
  # sender_password: ""
  # receiver_email: ""

# ============================================================
# Trading sessions
#
# When the market is closed the loop sleeps until the next session opens.
session_settings:
  calendar: NYSE
  extended_poll_multiplier: 3.0  # Polling interval multiplier for pre-market, after-hours and overnight

  # ⚠️ Overnight (20:00-03:50 ET) is off by default. Before enabling, check that:
  #    1. the IBKR account has Overnight Trading permission
  #    2. the symbols trade overnight (only some ETFs and large caps)
  #    3. strategy_settings.min_edge_pct has an overnight value; overnight spreads are often
  #       several times wider, so regular-hours cost assumptions overstate the edge
  enable_overnight: false

# ============================================================
# Feature scaler storage
scaler_settings:
  consolidated: true

# ============================================================
# Volatility estimate (σ)
#
# σ feeds four consumers: the threshold policy, exit geometry noise_floor / risk_cap,
# regime detection and risk-parity sizing. A wrong σ breaks each of them silently.
volatility_settings:
  lookback: 60              # Bars used to estimate realized volatility
  ewma_halflife: 20.0       # Half-life of the close-to-close fallback (only without OHLC)
  model_band_lo: 0.333      # Lower bound of model / realized
  model_band_hi: 3.0        # Upper bound. Both tails matter: an overstated σ widens stops
  abs_floor_per_bar: 0.0005 # Absolute per-bar floor so flat bars never give σ=0
  trust_model: true         # false bypasses GARCH and uses realized volatility only
  # Most entries here came from the GARCH intraday scaling bug; clear them once the
  # "model volatility differs" errors stop appearing in the log.
  distrust_symbols:
    - ASML
    - IBM
    - ISRG
    - KO
    - LMT
    - META
    - PG
    - V

# ============================================================
# Prediction-outcome ledger

ledger_settings:
  enabled: true

# ============================================================
# Execution costs
#
# ⚠️ Cost is not a fixed percentage. IBKR stock commission is per share with a per-order
#    minimum, so cost as a share of notional grows sharply as positions get smaller.

execution_cost_settings:
  # ibkr_tiered | ibkr_fixed | zero (IBKR Lite)
  # ⚠️ Set this to your account's actual plan. A wrong plan understates costs.
  commission_model: ibkr_tiered

  # Leave empty to use the plan's published rates; set both to override
  # per_share: 0.0035
  # minimum_per_order: 0.35

  default_spread_bps: 2.0          # Bid-ask spread (bps). About 1-3 for large caps, more for small caps
  slippage_bps: 1.0                # One-way slippage (bps)
  extended_spread_multiplier: 4.0  # Spread multiplier for pre-market, after-hours and overnight
  include_regulatory_fees: true    # SEC fee + FINRA TAF (sell leg only)

  # Gross edge must be this multiple of cost before an order is sent. A break-even trade
  # has zero expectancy and turns negative after forecast error, so keep a margin.
  safety_multiple: 1.5

# ============================================================
threshold_settings:
  mode: "quantile"
  quantile: 0.85
  min_samples: 40
  cold_start: "sigma"
  cost_floor_pct: 0.0003
  history_length: 500
  persist_history: true

  # --- Model collapse guard ---
  enable_collapse_guard: true
  collapse_min_samples: 25
  collapse_dispersion_floor: 0.00001    # Prediction std below this counts as constant

# ============================================================
# 3. IBKR connection
ib_settings:
  host: "127.0.0.1"
  port: 7497       # 7496/7497 = TWS live/paper, 4001/4002 = Gateway live/paper
  client_id: 1

# ============================================================
# 4. External API keys
api_keys_settings:
  fmp_api_key: ""  # Financial Modeling Prep
  fred_api_key: "" # Federal Reserve Economic Data

# ============================================================

regime_settings:
  # --- Moving average and indicator periods ---
  regime_ma_short: 20
  regime_ma_long: 50
  regime_adx_period: 14
  regime_atr_period: 14
  regime_adx_trend_threshold: 20.0
  regime_volatility_threshold_pct: 0.02

  # --- Asymmetric confirmation (the two most important values here) ---
  regime_bull_confirm_bars: 3
  regime_bear_confirm_bars: 1
  regime_use_closed_bars_only: true

  # --- Reversal risk score ---
  regime_reversal_lookback: 20
  regime_reversal_weights:
    momentum_fade: 0.22          # Fast MA slope flattening or turning down
    price_below_fast_ma: 0.20    # Close below the fast MA
    lower_highs: 0.20            # Pullback from the range high
    trend_exhaustion: 0.13       # ADX falling from its peak
    volatility_expansion: 0.13   # ATR rising above its own baseline
    distribution_volume: 0.12    # Down-bar volume above up-bar volume

# ============================================================
strategy_settings:
  # --- Position size ---
  base_position_pct: 0.08        # Base size per position (share of net liquidation)
  min_risk_parity_tilt: 0.5      # High-volatility symbols shrink to at most half the base
  max_risk_parity_tilt: 2.0      # Low-volatility symbols grow to at most twice the base

  # Size scaling by regime. Reducing and closing are never scaled down.
  size_scale_bull: 1.25
  size_scale_bear: 0.60
  size_scale_volatile: 0.70
  size_scale_quiet: 0.90

  # --- Entry/exit asymmetry ---
  exit_threshold_ratio: 0.5      # Exit threshold = entry threshold × this
  reversal_caution_level: 0.5    # Above this reversal risk the entry threshold starts rising
  reversal_threshold_boost: 1.0  # Threshold × (1 + risk × this)
  reversal_block_level: 0.75     # Above this reversal risk no new exposure is opened

  # --- Cost floor (coarse screen) ---
  # Coarse floor at the threshold stage. The real check runs before ordering, when
  # execution_cost_settings recomputes cost from the actual shares and price.
  min_edge_pct: 0.0010

  # A model whose prediction deviates from price by more than this is dropped
  max_prediction_deviation: 0.10
  allow_shorting: true
  max_gross_exposure: 1.0
  min_trade_usd: 120
  # Seconds to wait for a closing order to fill before cancelling it and
  # re-protecting the remaining shares.
  close_fill_timeout_sec: 60

# ============================================================
# Portfolio kill switch (DrawdownHaltRule). Blocks new entries only; exits are never blocked.
#   max_daily_loss_pct: loss vs. the day's first NLV (New York date); latched for the rest of the day
#   max_drawdown_pct:   drawdown from the all-time NLV peak; lifts once equity recovers
# State lives in data/risk_state.json. Delete it after a deposit or withdrawal. 0 disables a check.
risk_settings:
  max_daily_loss_pct: 0.02
  max_drawdown_pct: 0.10

# ============================================================
# Retraining schedule
# live and daemon modes retrain in a separate process while the market is closed (RetrainScheduler).
#   live:   closed = 20:00-04:00 (when overnight is off) and the whole weekend
#   daemon: closed = any time outside regular hours (09:30-16:00)
# Default is once per ISO week, on Saturday or Sunday. To retrain every closed night:
#   retrain_days: [mon, tue, wed, thu, fri, sat, sun]
#   retrain_every: day
# ⚠️ A weekday retrain can run into the next session; while it runs the system stays
#    connected but makes no trading decisions.
#
# ❄️ Model freeze
# Retraining must pause while ledger samples are collected: swapping models mid-way mixes
# two generations in one sample and makes the pooled slope meaningless, with no error shown.
# Clear the date or set it in the past to lift the freeze.
#
# Two weeks gives about 37 symbols × 10 trading days ≈ 370 samples, close to the ~500 needed
# to detect a 0.40 slope. When it expires, run analyze_ledger.py before deciding to retrain.
training_settings:
  auto_retrain: true          # false disables automatic retraining
  retrain_days: [sat, sun]    # Days retraining is allowed
  retrain_every: week         # week (once a week) | day (every allowed day)
  retry_minutes: 60           # Minutes before retrying a failed retrain
  retrain_client_id: 101      # IBKR client_id for the retrain process; must differ from the main one
  freeze_until: "2026-09-24"

# ============================================================
# 6. Walk-forward tuning
tuning_settings:
  walk_forward_models: ["ARIMA", "LSTM", "Transformer"]
  oos_fraction: 0.3          # Last 30% is out-of-sample
  trailing_window: 500       # Maximum history fed to the model per step

# ============================================================
benchmark_settings:
  default: "SPY"
  respect_trained_choice: true
  overrides:
    # NVDA: "SMH"
    # BRK B: "XLF"
    # ARM: "SMH"

  # --- Sector mapping ---
  enable_sector_mapping: true
  classifications:
    # NVDA: { sector: "Technology", industry: "Semiconductors" }
    # JPM:  { sector: "Financial Services" }

  # Override the built-in maps (11 GICS sectors and 6 common industries)
  sector_etf_map:
    # Technology: "XLK"
  industry_etf_map:
    # Semiconductors: "SMH"

  # --- Correlation ---
  # Picks the candidate whose returns correlate most with the symbol, no manual classification.
  # ⚠️ Every candidate's history is downloaded, which adds API usage.
  #    Keep only the sector ETFs you actually need.
  enable_correlation: true
  correlation_timeframe: "1 day"      # Daily bars, more stable than intraday
  correlation_lookback: 250           # About one trading year
  correlation_min_observations: 60    # No decision below this many observations
  correlation_min_threshold: 0.3      # If even the best candidate is below this, defer to default
  candidate_pool:
    - "SPY"
    - "QQQ"
    - "IWM"
    - "XLK"
    - "XLF"
    - "XLV"
    - "XLY"
    - "XLP"
    - "XLE"
    - "XLI"
    - "XLU"
    - "SMH"
    - "IGV"
    - "XBI"
    - "ITA"

# ============================================================
# 7. Asset pool
assets:
  - symbol: "SPY"
  - symbol: "VOO"
  - symbol: "QQQ"
